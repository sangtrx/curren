# Public read-model API
CURREN_DB_PATH=./.local/curren.db
CURREN_API_HOST=127.0.0.1
CURREN_API_PORT=8000
CURREN_PUBLIC_DELAY_SECONDS=1800

# Application-level rate limits (single-process protection).
# Keep a global/distributed limiter at ingress when running multiple workers/replicas.
CURREN_RATE_LIMIT_WINDOW_SECONDS=60
CURREN_PUBLIC_RATE_LIMIT=60
CURREN_AUTH_RATE_LIMIT=300
CURREN_INGEST_RATE_LIMIT=120

# Keep empty to disable ingestion. Replace for local/private integration testing.
CURREN_INGEST_TOKEN=

# Optional machine entitlements. Never commit real production keys.
# CURREN_API_KEYS_JSON={"crn_local_premium_123":"premium","crn_local_agent_12345":"agent"}
CURREN_API_KEYS_JSON={}

# Client defaults
CURREN_API_URL=http://127.0.0.1:8000
# CURREN_API_KEY=crn_local_premium_123

# MCP
CURREN_MCP_TRANSPORT=stdio
CURREN_MCP_HOST=127.0.0.1
CURREN_MCP_PORT=8001
